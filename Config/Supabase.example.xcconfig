// Copia este archivo como Supabase.xcconfig y llena los valores de tu proyecto.
// El host va sin https:// (en .xcconfig "//" se toma como comentario).
SUPABASE_HOST = tu-proyecto.supabase.co
SUPABASE_ANON_KEY = tu-anon-key
// Solo para Supabase local: SUPABASE_SCHEME = http y SUPABASE_HOST = 127.0.0.1:54321
SUPABASE_SCHEME = https
